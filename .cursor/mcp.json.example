{
  "mcpServers": {
    "ovaledge-local": {
      "command": "poetry",
      "args": ["-C", "${workspaceFolder}", "run", "oe-mcp-local"],
      "env": {
        "AUTH_MODE": "local",
        "MCP_PUBLIC_BASE_URL": "",
        "OVALEDGE_BASE_URL": "${env:OVALEDGE_BASE_URL}",
        "OVALEDGE_USER_TOKEN": "${env:OVALEDGE_USER_TOKEN}",
        "OVALEDGE_USER_SECRET": "${env:OVALEDGE_USER_SECRET}",
        "OVALEDGE_HTTP_AUTH_SCHEME": "jwt"
      }
    },
    "ovaledge-local-http": {
      "url": "http://127.0.0.1:8000/mcp"
    },
    "ovaledge-remote-http": {
      "url": "http://YOUR_REMOTE_HOST:8000/mcp",
      "headers": {
        "X-Forwarded-Proto": "https",
        "X-OvalEdge-Token": "${env:OVALEDGE_USER_TOKEN}",
        "X-OvalEdge-Secret": "${env:OVALEDGE_USER_SECRET}"
      }
    },
    "ovaledge-ecs": {
      "url": "https://YOUR_ALB_DNS/mcp",
      "headers": {
        "X-OvalEdge-Token": "${env:OVALEDGE_USER_TOKEN}",
        "X-OvalEdge-Secret": "${env:OVALEDGE_USER_SECRET}"
      }
    },
    "ovaledge-remote-local": {
      "url": "https://YOUR_API_ID.execute-api.YOUR_REGION.amazonaws.com/mcp",
      "headers": {
        "X-Forwarded-Proto": "https",
        "X-OvalEdge-Token": "${env:OVALEDGE_USER_TOKEN}",
        "X-OvalEdge-Secret": "${env:OVALEDGE_USER_SECRET}"
      }
    },
    "ovaledge-remote-lambda": {
      "url": "https://YOUR_API_ID.execute-api.YOUR_REGION.amazonaws.com/mcp",
      "headers": {
        "X-OvalEdge-Token": "${env:OVALEDGE_USER_TOKEN}",
        "X-OvalEdge-Secret": "${env:OVALEDGE_USER_SECRET}"
      }
    },
    "ovaledge-remote-oauth-wip": {
      "url": "https://YOUR_API_ID.execute-api.YOUR_REGION.amazonaws.com/mcp",
      "headers": {
        "X-Forwarded-Proto": "https",
        "Authorization": "Bearer ${env:OAUTH_ACCESS_TOKEN}"
      }
    }
  }
}
