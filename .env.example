# ── OvalEdge ─────────────────────────────────────────────────────
OVALEDGE_BASE_URL=https://your-instance.ovaledge.com
OVALEDGE_TIMEOUT_SECONDS=30
# Authorization header scheme for OvalEdge API calls (value + space + JWT). Default: jwt
OVALEDGE_HTTP_AUTH_SCHEME=jwt
# Log every outbound OvalEdge URL to stderr (Cursor MCP log / CloudWatch). false to disable.
OVALEDGE_LOG_HTTP_REQUESTS=true
OVALEDGE_MAX_RETRIES=3
OVALEDGE_RETRY_BACKOFF_SECONDS=0.5

# ── Auth mode ─────────────────────────────────────────────────────
# "local"  → OvalEdge user token exchange (stdio)
# "remote" → Okta OAuth 2.1 PKCE (Lambda)
AUTH_MODE=local

# ── Local MCP — OvalEdge user token credentials ───────────────────
OVALEDGE_USER_TOKEN=your-ovaledge-user-token
OVALEDGE_USER_SECRET=your-ovaledge-user-secret

# ── Remote MCP — set in Lambda env vars, not .env ─────────────────
# AUTH_MODE=remote
# OKTA_DOMAIN=https://your-org.okta.com
# OKTA_AUTH_SERVER_ID=aus1ab2cd3ef4gh5ij
# OKTA_CLIENT_ID=0oa1ab2cd3ef4gh5ij
# OKTA_AUDIENCE=                        # TODO: confirm with Okta admin
# MCP_PUBLIC_BASE_URL=https://abc123.execute-api.us-east-1.amazonaws.com
# AWS_REGION=us-east-1
