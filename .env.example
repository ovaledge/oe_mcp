# =============================================================================
# OvalEdge — required for both local and remote modes
# =============================================================================
OVALEDGE_BASE_URL=http://localhost:8080/ovaledge
OVALEDGE_TIMEOUT_SECONDS=30
# Outbound Authorization header: "<scheme> <token>". Use `oauth2` or `Bearer` when forwarding
# IdP OIDC access tokens; use `jwt` when the value is an OvalEdge-issued JWT.
OVALEDGE_HTTP_AUTH_SCHEME=jwt
OVALEDGE_LOG_HTTP_REQUESTS=true
OVALEDGE_MAX_RETRIES=3
OVALEDGE_RETRY_BACKOFF_SECONDS=0.5

# =============================================================================
# AUTH_MODE — choose one flow
# =============================================================================
# local  → stdio MCP (poetry run oe-mcp-local): OvalEdge user token + secret at startup
# remote → HTTP MCP (uvicorn entrypoints.lambda_handler:app): Bearer OAuth JWT per request
AUTH_MODE=local

# -----------------------------------------------------------------------------
# Local MCP only — required when AUTH_MODE=local
# -----------------------------------------------------------------------------
OVALEDGE_USER_TOKEN=your-ovaledge-user-token
OVALEDGE_USER_SECRET=your-ovaledge-user-secret

# -----------------------------------------------------------------------------
# Remote MCP only — required when AUTH_MODE=remote
# -----------------------------------------------------------------------------
# Issuer base for MCP discovery proxy. JWT validation uses the access token ``iss`` for OIDC discovery.
# Discovery:
#   {OAUTH_ISSUER}/.well-known/openid-configuration
#   then {OAUTH_ISSUER}/.well-known/oauth-authorization-server
OAUTH_ISSUER=https://integrator-3017728.okta.com/oauth2/default
# Resource identifier; must match access token ``aud`` (Okta API / Auth0 API identifier).
OAUTH_AUDIENCE=api://ovaledge-mcp
# Public base URL of this MCP server (registration_endpoint in discovery).
# Local:  MCP_PUBLIC_BASE_URL=http://127.0.0.1:8000
# Lambda: MCP_PUBLIC_BASE_URL=https://xxxx.execute-api.region.amazonaws.com
MCP_PUBLIC_BASE_URL=http://127.0.0.1:8000

# Remote: if true, skip POST /api/user/token/generate and send the validated IdP access token to
# OvalEdge. If false, exchange IdP token for an OvalEdge JWT via token/generate first.
OVALEDGE_REMOTE_FORWARD_IDP_TOKEN=true

# When OVALEDGE_REMOTE_FORWARD_IDP_TOKEN=true, set scheme for the outbound token, e.g.:
OVALEDGE_HTTP_AUTH_SCHEME=Bearer

# Optional — default us-east-1
AWS_REGION=us-east-1

# Optional — override MCP product strings
# MCP_SERVER_NAME=OvalEdge MCP Server
# MCP_SERVER_VERSION=0.1.0
