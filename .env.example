# =============================================================================
# OvalEdge MCP Configuration
# =============================================================================
# Choose your mode via AUTH_MODE, then fill only that mode's section.
# - Local MCP  (stdio):  poetry run oe-mcp-local
# - Remote MCP (HTTP):   uvicorn entrypoints.lambda_handler:app

# =============================================================================
# Shared (used by both Local and Remote MCP)
# =============================================================================
OVALEDGE_BASE_URL=http://localhost:8080/ovaledge
# Optional: user-facing link base when API base differs (pod/custom hostname).
# OVALEDGE_LINK_BASE_URL=https://my-pod.example.com/ovaledge
# OVALEDGE_PREFER_LOCALHOST_LINKS=true
OVALEDGE_TIMEOUT_SECONDS=30
OVALEDGE_LOG_HTTP_REQUESTS=true
OVALEDGE_MAX_RETRIES=3
OVALEDGE_RETRY_BACKOFF_SECONDS=0.5
# Optional: when token/generate returns 200 with empty body, read JWT from this header.
# OVALEDGE_TOKEN_EXCHANGE_FALLBACK_HEADER=X-Your-Token-Header

# =============================================================================
# Mode Selection
# =============================================================================
# local                 -> stdio MCP, uses OVALEDGE_USER_TOKEN + OVALEDGE_USER_SECRET
# remote                -> HTTP MCP, uses OAuth/OIDC access tokens (Bearer)
# remote_credentials    -> HTTP MCP, per-user OvalEdge token+secret in request headers
AUTH_MODE=local

# =============================================================================
# Local MCP Section (required when AUTH_MODE=local)
# =============================================================================
# Auth scheme used for outbound OvalEdge API calls in local mode.
# Usually this should be jwt when using OvalEdge-issued tokens.
OVALEDGE_HTTP_AUTH_SCHEME=jwt

OVALEDGE_USER_TOKEN=your-ovaledge-user-token
OVALEDGE_USER_SECRET=your-ovaledge-user-secret

# =============================================================================
# Remote MCP Section (required when AUTH_MODE=remote)
# =============================================================================
# Okta / OIDC Connect: MCP clients use the Connect button → authorize on Okta.
# This server validates the access token and forwards Authorization: Bearer to OvalEdge
# (OvalEdge introspects the same token). Do not put OVALEDGE_USER_TOKEN on the server.
#
# Issuer base for discovery proxy + opaque introspect default ({issuer}/v1/introspect).
OAUTH_ISSUER=https://integrator-4245604.okta.com/oauth2/default
# Comma-separated additional trusted JWT iss values (Auth0: custom domain and *.auth0.com).
OAUTH_ALLOWED_ISSUERS=
# Resource identifier / JWT aud (optional). Leave empty for Okta default AS —
# MCP prefers token introspection when OAUTH_CLIENT_ID is set (same as OvalEdge).
# OAUTH_AUDIENCE=api://default
OAUTH_AUDIENCE=
# Pre-registered Okta OIDC app (returned by POST /register). Prefer a dedicated MCP app.
# Register Sign-in redirect URIs for Cursor, Claude, GitHub Copilot, Microsoft Copilot —
# see README_REMOTE_MCP.md (#okta-redirect-uris-all-clients).
OAUTH_CLIENT_ID=0oa124ev9ftSqswfQ698
# Required for Okta token introspection (same as OvalEdge api.introspection credentials).
# Also required on the MCP server for confidential Okta Web apps (POST /register returns secret).
# Do not put this in client mcp.json.
OAUTH_CLIENT_SECRET=your-okta-client-secret
# Optional override; default is {OAUTH_ISSUER}/v1/introspect
# OAUTH_INTROSPECTION_URL=https://integrator-4245604.okta.com/oauth2/default/v1/introspect
OAUTH_SCOPES="openid profile email"

# Public base URL of this MCP server (registration_endpoint in discovery).
# Local:  MCP_PUBLIC_BASE_URL=http://127.0.0.1:8000
# Lambda: set to stack output MCPPublicBaseUrl (no /mcp), e.g.
# MCP_PUBLIC_BASE_URL=https://xxxx.execute-api.region.amazonaws.com
MCP_PUBLIC_BASE_URL=http://127.0.0.1:8000

# Default true for Okta resource-server pods — forward IdP token; skip token/generate.
OVALEDGE_REMOTE_FORWARD_IDP_TOKEN=true
# Auth scheme for forwarded IdP token (Bearer). Auto-upgraded from jwt when forwarding.
OVALEDGE_HTTP_AUTH_SCHEME=Bearer

# Optional — default us-east-1
AWS_REGION=us-east-1

# Optional — override MCP product strings
# MCP_SERVER_NAME=OvalEdge MCP Server
# MCP_SERVER_VERSION=0.1.0
# MCP icon: server/static/ovaledge-mcp-icon.png at GET /brand/ovaledge-mcp-icon.png
# Lambda: set MCP_PUBLIC_BASE_URL=https://xxxx.execute-api.region.amazonaws.com
# Local dev logo in Cursor: Cursor ignores http://127.0.0.1 icons — set a deployed HTTPS base:
# MCP_BRAND_ICON_BASE_URL=https://xxxx.execute-api.region.amazonaws.com
# MCP_BRAND_ICON_BASE_URL=

# =============================================================================
# Remote MCP — per-user credentials (required when AUTH_MODE=remote_credentials)
# =============================================================================
# Clients send credentials on every POST /mcp (and other protected routes), either:
#   X-OvalEdge-Credentials: <token>::<secret>   (single header; e.g. Copilot Studio API key)
# or:
#   X-OvalEdge-Token: <OvalEdge user token>
#   X-OvalEdge-Secret: <OvalEdge user secret>
# OvalEdge token/secret values do not contain "::".
# The server exchanges them for an OvalEdge JWT, caches per credential key in-process,
# and refreshes ~60 seconds before JWT expiry. Use HTTPS only.
#
# AUTH_MODE=remote_credentials
# OVALEDGE_HTTP_AUTH_SCHEME=jwt
# CREDENTIALS_CACHE_MAX_ENTRIES=10000
#
# Cursor / local HTTP MCP: set false so GET /mcp is registered (SSE fallback after Streamable HTTP).
# Lambda / production: leave default true (stateless POST/DELETE only).
# MCP_HTTP_STATELESS=false

# =============================================================================
# Telemetry (OpenTelemetry → Phoenix or Langfuse)
# =============================================================================
# TELEMETRY_BACKEND=none          # none (default) | phoenix | langfuse
# TELEMETRY_SERVICE_NAME=oe-mcp
# TELEMETRY_PROJECT_NAME=oe_mcp
#
# Phoenix (TELEMETRY_BACKEND=phoenix):
# PHOENIX_HOST=http://localhost:6006
# PHOENIX_API_KEY=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJqdGkiOiJBcGlLZXk6MyJ9.XaDBqvUAhDbyQeqlg0Rrq5WLQmvVbzhoz0hYpRYu4JY                # required when Phoenix auth is enabled
#
# Langfuse (TELEMETRY_BACKEND=langfuse):
# LANGFUSE_HOST=http://localhost:3000
# LANGFUSE_PUBLIC_KEY=pk-lf-ac427197-fdcd-4b52-8e19-91b8d5490164
# LANGFUSE_SECRET_KEY=sk-lf-0075f50a-49ba-4def-be6f-32df9750fa44
#
# Optional override (any backend):
# TELEMETRY_OTLP_ENDPOINT=http://localhost:6006/v1/traces
# TELEMETRY_API_KEY=              # Bearer header when using TELEMETRY_OTLP_ENDPOINT
#
# Privacy: when enabled, OTLP spans may include tool argument summaries (search terms,
# object ids) — review before exporting to a third-party backend.
